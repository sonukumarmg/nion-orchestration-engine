# ══════════════════════════════════════════════════════════════════════════════
# NION Orchestration Engine — Spring Boot Environment Template
# ══════════════════════════════════════════════════════════════════════════════

# ── Core Security ─────────────────────────────────────────────────────────────
NION_JWT_SECRET=dev-secret-change-me-dev-secret-change-me
NION_JWT_ISSUER=nion
NION_JWT_MINUTES=60

# ── LLM Provider (Spring AI) ──────────────────────────────────────────────────
# Use mock to run without external API keys.
NION_LLM_PROVIDER=mock
NION_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Databases ─────────────────────────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/nion
POSTGRES_USER=nion
POSTGRES_PASSWORD=nion
MONGO_URI=mongodb://localhost:27017/nion
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Notifications ─────────────────────────────────────────────────────────────
NION_WEBHOOK_URL=

# ── Bootstrap Admin (optional) ────────────────────────────────────────────────
NION_ADMIN_USERNAME=admin
NION_ADMIN_PASSWORD=admin123
NION_ADMIN_EMAIL=admin@nion.local
NION_ADMIN_NAME=NION Admin
NION_ADMIN_TENANT=default
